# Neon Postgres - filled in automatically by `npx neon link` / `npx neon deploy`
DATABASE_URL=
DATABASE_URL_UNPOOLED=
GEMINI_API_KEY=
# Optional: comma-separated models, tried in order
# (defaults to gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest)
GEMINI_MODEL=
# Leave blank until checkpoint B·2 - the app runs without it
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
# MESA test inbox - every email goes here while SEND_MODE=test
TEST_RECIPIENT_EMAIL=
# test (default) or live
SEND_MODE=test
# Password for the app (any username). Required when deployed; blank = no prompt locally
APP_PASSWORD=
